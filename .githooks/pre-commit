#!/usr/bin/env bash
# Bump the patch component before every normal commit.
# release.sh sets CELLSCOPE_SKIP_VERSION_BUMP=1 because it performs its own
# minor/major bump.

set -euo pipefail

[ "${CELLSCOPE_SKIP_VERSION_BUMP:-0}" = "1" ] && exit 0

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

python3 "$ROOT/scripts/version.py" bump patch >/dev/null

git add CMakeLists.txt README.md .github/workflows/cmake-multi-platform.yml
